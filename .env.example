# Скопируй в .env и заполни. Файл .env в git не коммитится (см. .gitignore).

# --- Доступы (нужны только для боевого запуска; для разработки оставь пустыми) ---
# Токен Telegram-бота от @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=
# API-ключ из Anthropic Console -> API Keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# --- Выбор провайдера LLM ---
# mock      -> детерминированные ответы, работает без ключей (дефолт для разработки/тестов)
# anthropic -> реальный Anthropic API (нужен ANTHROPIC_API_KEY)
# local     -> локальная модель через Ollama (нужен запущенный Ollama)
LLM_PROVIDER=mock

# Модель Anthropic (применяется при LLM_PROVIDER=anthropic)
LLM_MODEL=claude-haiku-4-5

# Имя модели Ollama (применяется при LLM_PROVIDER=local)
LOCAL_MODEL=llama3.1
# Базовый URL Ollama (OpenAI-совместимый эндпоинт)
LOCAL_BASE_URL=http://localhost:11434/v1

# --- Прочее ---
# Таймаут запроса к LLM, сек
REQUEST_TIMEOUT=30
# Максимальная длина одного текстового ввода (символов)
MAX_INPUT_CHARS=15000
